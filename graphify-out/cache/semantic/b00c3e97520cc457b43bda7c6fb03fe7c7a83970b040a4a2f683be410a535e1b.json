{"nodes": [{"id": "readme", "label": "README TokenStone", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_tokenstone", "label": "TokenStone (piattaforma di mondi)", "file_type": "concept", "source_file": "README.md", "source_location": "L1-L18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Worlds built step by step with Claude Code token usage; one world lasts weeks or months; engine is shared, each world brings only what makes it itself. Name is provisional."}, {"id": "readme_acropoli_di_pericle", "label": "Mondo: Acropoli di Pericle", "file_type": "concept", "source_file": "README.md", "source_location": "L10-L16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "3,280 independent pieces with cost, mason's mark and historical phase, sized for about a month at 100% weekly Claude Code usage."}, {"id": "readme_piana_di_giza", "label": "Mondo in arrivo: Piana di Giza", "file_type": "concept", "source_file": "README.md", "source_location": "L18", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_foro_romano", "label": "Mondo in arrivo: Foro Romano", "file_type": "concept", "source_file": "README.md", "source_location": "L18", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_token_equivalenti", "label": "Token Equivalenti (TE)", "file_type": "concept", "source_file": "README.md", "source_location": "L232-L241", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dollar cost at list price converted via te_per_usd (200,000): one TE = one Opus input token. Weighs tokens of different models on the same scale; the dollar value is only shown in a note because subscribers don't pay it."}, {"id": "readme_registro_dei_mondi", "label": "Registro dei mondi (state/registry.json)", "file_type": "concept", "source_file": "README.md", "source_location": "L147-L193", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The counter knows only one total; the registry splits it among worlds via segments of the total, remembers the highest point reached per world (so price drops never un-build) and each world's cost (to compute carryover)."}, {"id": "readme_tratti_di_credito", "label": "Tratti di credito (un mondo attivo alla volta)", "file_type": "rationale", "source_file": "README.md", "source_location": "L152-L157", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_pausa_e_avanzo", "label": "Pausa e avanzo del credito", "file_type": "rationale", "source_file": "README.md", "source_location": "L154-L157", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A half-built world keeps its credit when paused; a completed world passes surplus to the next chosen one, which waits and is never lost."}, {"id": "readme_cantiere_calcolato_dal_credito", "label": "I blocchi posati si calcolano, non si salvano", "file_type": "rationale", "source_file": "README.md", "source_location": "L170-L179", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Given credit and ordered piece costs, placed blocks are a computation; the site is identical in every browser/device and nothing of progress lives in the browser."}, {"id": "readme_prezzo_pezzi_pesi_relativi", "label": "Prezzo dei pezzi da pesi relativi (priceInTe)", "file_type": "rationale", "source_file": "README.md", "source_location": "L243-L255", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "COST values are relative weights; budget = weeklyTe * weeks, cost(p) = weight(p) * budget / sum(weights), so the total stays exact when pieces are added while hand-tuned proportions are preserved."}, {"id": "readme_weekly_te_misura", "label": "Misura di CANTIERE.weeklyTe (66 milioni TE)", "file_type": "concept", "source_file": "README.md", "source_location": "L257-L292", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Weekly TE value is not public and plan-dependent; measured from /usage percentage plus counter --dry-run --since: weeklyTe = total_te / pct * 100. Two readings (12% and 19%) bound it to 65.0-67.2M; earlier 31M reading was polluted by claude.ai use. 5-hour window is a different limit and is not used."}, {"id": "readme_contatore_di_token", "label": "Contatore di token (transcript Claude Code)", "file_type": "concept", "source_file": "README.md", "source_location": "L197-L231", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reads ~/.claude/projects/*/*.jsonl every five seconds, weighs usage at list price and rewrites state/world-state.json; counts all projects, only after first start (installed_at), only on this computer; runs inside the server so no orphan processes."}, {"id": "readme_privacy_solo_usage", "label": "Privacy: solo message.usage, modello, orario, cartella", "file_type": "rationale", "source_file": "README.md", "source_location": "L206-L216", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Message text, questions, answers and code are never read or copied; nothing goes to the network; state stays in state/."}, {"id": "readme_scelte_che_proteggono_il_conto", "label": "Le scelte che proteggono il conto", "file_type": "rationale", "source_file": "README.md", "source_location": "L356-L387", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recompute never sum (idempotent scans); one message counted once (highest output per message.id, first session wins); subagents roll into parent session; deleted sessions kept as archived; tail-only reads; backup .world-state.bak; atomic write + .world-state.lock; single process inside the server."}, {"id": "readme_listino_prezzi_modelli", "label": "Listino prezzi modelli (pricing.json)", "file_type": "concept", "source_file": "README.md", "source_location": "L294-L320", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Re-read every cycle so corrections apply without restart. Models matched by exact name or dated suffix; unknown versions priced from nearest entry but flagged in unknown_models/model_fallbacks. fast_multiplier covers /fast mode; <synthetic> messages don't count."}, {"id": "readme_unknown_models", "label": "unknown_models e model_fallbacks", "file_type": "concept", "source_file": "README.md", "source_location": "L300-L306", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_prezzo_che_scende", "label": "Quando un prezzo scende", "file_type": "rationale", "source_file": "README.md", "source_location": "L350-L354", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recomputed total drops, but placed blocks remain because the registry remembers the highest point; the site pauses until new usage catches up. Archived sessions keep their original price."}, {"id": "readme_modalita_dimostrativa", "label": "Modalita dimostrativa (?demo)", "file_type": "concept", "source_file": "README.md", "source_location": "L109-L112", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Whole world in about 90 s with camera following; ?demo=N sets duration; never touches the registry, so the project can be seen without Claude Code."}, {"id": "readme_modalita_dev", "label": "Modalita sviluppo (?dev)", "file_type": "concept", "source_file": "README.md", "source_location": "L131-L137", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single placement, continuous build, gifted simulation credit and 'Tutto in 10 s'; gifted credit stays in the browser and never reaches the registry."}, {"id": "readme_laboratorio", "label": "Il laboratorio (torre di prova)", "file_type": "concept", "source_file": "README.md", "source_location": "L139-L143", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Surfaces dev modes and the world template from the home page instead of hiding them in the URL; nothing there consumes credit."}, {"id": "readme_sicurezza_scritture_registro", "label": "Scritture del registro solo locali, JSON, da pagine TokenStone", "file_type": "rationale", "source_file": "README.md", "source_location": "L187-L193", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only two writes ('scegli mondo', 'riporta avanzamento') accepted from localhost as JSON from TokenStone pages so another site in the browser cannot alter the site; server listens only locally because state reveals work habits."}, {"id": "readme_ricarica_su_versione", "label": "Ricarica automatica su nuova versione / scollegato dal cantiere", "file_type": "concept", "source_file": "README.md", "source_location": "L181-L185", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_app_installabile", "label": "TokenStone come app installabile (PWA)", "file_type": "concept", "source_file": "README.md", "source_location": "L49-L58", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_avvio_doppio_clic", "label": "Avvio a doppio clic (TokenStone.cmd / .command / tokenstone.sh)", "file_type": "concept", "source_file": "README.md", "source_location": "L28-L47", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server need not stay on: transcripts are the site's memory and the counter catches up on start; caveat is Claude Code deletes transcripts older than a month."}, {"id": "readme_roccia_non_si_paga", "label": "La roccia affiorante non si paga", "file_type": "rationale", "source_file": "README.md", "source_location": "L488-L490", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bedrock existed before; everything carried up by hand costs tokens."}, {"id": "readme_ordine_pezzi_e_seme_fisso", "label": "Ordine dei pezzi e generatore con seme fisso", "file_type": "rationale", "source_file": "README.md", "source_location": "L492-L495", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The site is 'the first N pieces of the list' and the registry remembers N; changing order or seed would make those N different pieces."}, {"id": "readme_raffinatezze_ottiche", "label": "Raffinatezze ottiche (REFINEMENTS)", "file_type": "concept", "source_file": "README.md", "source_location": "L503-L516", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Curved stylobate, inward column tilt 1:171, thickened corner columns, contracted corner intercolumniations; crepidoma goes from 36 to 108 blocks because a temple-wide block cannot curve."}, {"id": "readme_policromia", "label": "Policromia (POLYCHROMY)", "file_type": "concept", "source_file": "README.md", "source_location": "L509-L512", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_sculture_fotogrammetrate", "label": "Sculture fotogrammetrate (setSculptureProvider)", "file_type": "concept", "source_file": "README.md", "source_location": "L522-L530", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_hdri_vs_cielo_analitico", "label": "HDRI al posto del cielo analitico (useHDRI)", "file_type": "concept", "source_file": "README.md", "source_location": "L532-L539", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Analytic sky keeps time of day as a continuous parameter with real solar equations for Athens' latitude; HDRI would give that up."}, {"id": "readme_bakephase_prestazioni", "label": "Prestazioni: bakePhase e ombre su posa", "file_type": "concept", "source_file": "README.md", "source_location": "L543-L552", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Merging a closed phase's meshes per material drops draw calls from thousands to dozens; shadow map recomputed only on placement."}, {"id": "readme_hook_stop_legacy", "label": "Hook Stop e server Python/FastAPI (versioni precedenti)", "file_type": "concept", "source_file": "README.md", "source_location": "L408-L417", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme", "target": "readme_tokenstone", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L1", "weight": 1.0}, {"source": "readme_tokenstone", "target": "readme_acropoli_di_pericle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L10", "weight": 1.0}, {"source": "readme_tokenstone", "target": "readme_piana_di_giza", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L18", "weight": 1.0}, {"source": "readme_tokenstone", "target": "readme_foro_romano", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L18", "weight": 1.0}, {"source": "readme_contatore_di_token", "target": "readme_token_equivalenti", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L232-L241", "weight": 1.0}, {"source": "readme_contatore_di_token", "target": "readme_listino_prezzi_modelli", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RE